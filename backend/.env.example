# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Connection URI (Local or MongoDB Atlas Cluster)
# Example: mongodb+srv://username:password@cluster.mongodb.net/urlshortener?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/urlshortener

# Base URL for generated short links (Match your production backend URL or domain)
# Example: https://shortx-api.onrender.com or https://shortx.app
BASE_URL=http://localhost:5000

# Secret Key for JWT Authentication Signing (Use a long, unique random string in production)
JWT_SECRET=your_production_jwt_secret_key_here

# Allowed Frontend Origin for CORS (Match your production frontend deployment URL)
# Example: https://shortx.vercel.app
FRONTEND_URL=http://localhost:5173
